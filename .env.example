# =========================================================================
# Project Configuration
# =========================================================================

# 1. API Toggle for Portfolio/Showcase Mode
# -------------------------------------------------------------------------
# Set this to "true" to run the app entirely in the browser using Mock API
# and localStorage. This allows you to deploy the app to Vercel/Netlify/GitHub Pages
# as a fully functioning static demo with login, cart, favorites, and AI generation.
VITE_APP_USE_MOCK_API=true

# 2. Real Backend Configuration (Optional)
# -------------------------------------------------------------------------
# Define these if you want to connect to a live backend.
# If these are empty or undefined, the application will automatically default to Mock Mode.
VITE_APP_API_URL=https://api.yourclientbackend.com

# 3. Firebase Configuration (Optional)
# -------------------------------------------------------------------------
# If these are empty, mock authentication and storage will be used.
VITE_APP_FIREBASE_API_KEY=
VITE_APP_FIREBASE_AUTH_DOMAIN=
VITE_APP_FIREBASE_DATABASE_URL=
VITE_APP_FIREBASE_PROJECT_ID=
VITE_APP_FIREBASE_STORAGE_BUCKET=
VITE_APP_FIREBASE_MESSAGING_SENDER_ID=
VITE_APP_FIREBASE_APP_ID=
VITE_APP_FIREBASE_MEASUREMENT_ID=
